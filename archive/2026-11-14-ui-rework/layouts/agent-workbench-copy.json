{
  "id": "root",
  "cloned_from": {
    "name": "agent-workbench",
    "version": "0.1.15"
  },
  "type": "column",
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "floating": [
    {
      "id": "notify-float",
      "content": {
        "mod": "notify"
      },
      "edge": "right",
      "align": "end"
    }
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "toast": "notify-toast",
  "children": [
    {
      "id": "top",
      "type": "block",
      "content": {
        "mod": "workbench-top"
      },
      "size": {
        "px": 46
      },
      "window_drag": true
    },
    {
      "id": "main-row",
      "type": "row",
      "children": [
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "workbench-brand"
              },
              "size": {
                "px": 46
              },
              "window_drag": true
            },
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "agent-workbench"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                }
              ]
            }
          ],
          "size": {
            "px": 268
          },
          "min": 240,
          "max": 480,
          "background": "chrome",
          "resizable": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "workbench-crumb"
              },
              "size": {
                "px": 38
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "workbench-pane"
                        },
                        "reveal": "hover",
                        "height": 28,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 10,
                      "gap": 8,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "changes"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 368
                  },
                  "min": 280,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": 8,
              "gap": 8
            }
          ],
          "resizable": false
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "content": {
        "mod": "workbench-status"
      },
      "size": {
        "px": 28
      }
    }
  ]
}